# Copy to backend/.env (backend) and frontend/.env (frontend vars start with VITE_). NEVER commit real values.
APP_ENV=development                       # development | test | production
APP_SECRET_KEY=                           # python -c "import secrets; print(secrets.token_urlsafe(48))"  (>=32 chars in production)
DATABASE_URL=sqlite:///./nexis_dev.db     # production: postgresql://user:pass@host:5432/nexis
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173        # comma-separated, no wildcard in production

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false                       # must be true in production
COOKIE_SAMESITE=lax                       # lax | strict | none (none requires COOKIE_SECURE=true)
COOKIE_DOMAIN=

OPENAI_API_KEY=                           # optional: without it the app runs, live AI execution is disabled
OPENAI_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=6
EXECUTION_MAX_SECONDS=120
EXECUTION_MAX_CONCURRENCY=4

GOOGLE_CLIENT_ID=                         # optional: Google login reports "not configured" without these
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

TOOL_SECRET_ENCRYPTION_KEY=               # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOOL_OUTBOUND_ALLOWLIST=                  # optional comma-separated hostnames for custom REST tools
TOOL_ALLOW_HTTP=false
BRAVE_SEARCH_API_KEY=                     # optional: enables the web_search tool (Brave Search API)

RATE_LIMIT_AUTH=10/60                     # requests/seconds per IP on auth endpoints
RATE_LIMIT_API=120/60
LOG_LEVEL=INFO
